# Copy this file to .env and fill in only the providers you use.
FLASK_SECRET_KEY=
GNOJO_REVIEWER_USERNAME=
# Generate with: python -c "from getpass import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass('Password: ')))"
GNOJO_REVIEWER_PASSWORD_HASH=
GNOJO_SESSION_COOKIE_SECURE=false
GNOJO_SESSION_LIFETIME_MINUTES=480
GNOJO_DEBUG=false
GNOJO_SESSION_ENVIRONMENT=production
GNOJO_DATA_ROOT=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
